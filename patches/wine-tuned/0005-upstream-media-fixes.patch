Backport five Wine media runtime fixes onto the P3-tuned source baseline.

Upstream commits:
- 91fabe0d1dc0f766df0c54809b0b2811f28bcf1d (resampledmo time denominator overflow)
- 5b7db73f174be3ef98fd80e2a7ccf608f357fb7b (winegstreamer 256 KiB input chunks)
- f360ce3e9bf650bc41abf0cf26d420b2180add93 (mfreadwrite ALL_STREAMS end-of-segment index)
- 2f73d9efc2a060b56cde465e3d3cac523823ef5d (mfreadwrite async command Release leak)
- 7c48881f4fe2edba88f70b2e1b0892d3d98c8b19 (amstream flushing allocator wake)

Runtime hunks only; upstream test-only changes are intentionally omitted.

diff --git a/dlls/amstream/ddrawstream.c b/dlls/amstream/ddrawstream.c
index fc4eba5..7409eda 100644
--- a/dlls/amstream/ddrawstream.c
+++ b/dlls/amstream/ddrawstream.c
@@ -1426,6 +1426,7 @@ static HRESULT WINAPI ddraw_sink_BeginFlush(IPin *iface)
     stream->flushing = TRUE;
     stream->eos = FALSE;
     WakeConditionVariable(&stream->update_queued_cv);
+    WakeAllConditionVariable(&stream->allocator_cv);
 
     LeaveCriticalSection(&stream->cs);
 
@@ -1616,10 +1617,10 @@ static HRESULT WINAPI ddraw_mem_allocator_GetBuffer(IMemAllocator *iface,
 
     EnterCriticalSection(&stream->cs);
 
-    while (stream->committed && !(sample = get_pending_sample(stream)))
+    while (stream->committed && !stream->flushing && !(sample = get_pending_sample(stream)))
         SleepConditionVariableCS(&stream->allocator_cv, &stream->cs, INFINITE);
 
-    if (!stream->committed)
+    if (!stream->committed || stream->flushing)
     {
         LeaveCriticalSection(&stream->cs);
         return VFW_E_NOT_COMMITTED;
