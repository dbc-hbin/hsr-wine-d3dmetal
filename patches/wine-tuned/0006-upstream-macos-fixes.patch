From: Wine upstream selective backports
Subject: [PATCH] Backport macOS, debug-event, OpenGL, and IME runtime fixes

Upstream commits:
- 5960f8049bb185b1a789b4ee8efaedbe1feb8b6f imm32: Explicitly link against kernel32 before kernelbase.
- 6850fba76d365e8855b5a81432d32781693cce2f winemac: Use the latched client surface toplevel window.
- d119a0c94a0a9cdabc42b28c607584e357295413 ntdll: Send debug event exceptions as exception space.
- 0e36c06949adbd1a409990fce171060968c6935b win32u: Make sure glDrawArrays has an active VAO.

This is a runtime-only backport onto the pinned P3/tuned source. The upstream
ntdll test-only todo removal is intentionally omitted.

diff --git a/dlls/imm32/Makefile.in b/dlls/imm32/Makefile.in
--- a/dlls/imm32/Makefile.in
+++ b/dlls/imm32/Makefile.in
@@ -1,6 +1,6 @@
 MODULE    = imm32.dll
 IMPORTLIB = imm32
-IMPORTS   = user32 gdi32 advapi32 kernelbase win32u
+IMPORTS   = user32 gdi32 advapi32 kernel32 kernelbase win32u
 DELAYIMPORTS = ole32
 
 VER_PRODUCTVERSION = 5,1,2600,2180
diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -1103,7 +1103,7 @@
 static void macdrv_client_surface_update(struct client_surface *client)
 {
     struct macdrv_client_surface *surface = impl_from_client_surface(client);
-    HWND hwnd = client->hwnd, toplevel = NtUserGetAncestor(hwnd, GA_ROOT);
+    HWND hwnd = client->hwnd, toplevel = client->toplevel;
     struct macdrv_win_data *data;
 
     TRACE("%s\n", debugstr_client_surface(client));
diff --git a/dlls/ntdll/unix/signal_arm.c b/dlls/ntdll/unix/signal_arm.c
--- a/dlls/ntdll/unix/signal_arm.c
+++ b/dlls/ntdll/unix/signal_arm.c
@@ -527,7 +527,7 @@
     void *stack_ptr = (void *)(SP_sig(sigcontext) & ~7);
     NTSTATUS status;
 
-    status = send_debug_event( data, rec, context, TRUE, TRUE );
+    status = send_debug_event( data, rec, context, TRUE );
     if (status == DBG_CONTINUE || status == DBG_EXCEPTION_HANDLED)
     {
         restore_context( context, sigcontext );
diff --git a/dlls/ntdll/unix/signal_arm64.c b/dlls/ntdll/unix/signal_arm64.c
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -778,7 +778,7 @@
 
     if (!chpe || !chpe->InSimulation)
     {
-        NTSTATUS status = send_debug_event( data, rec, context, TRUE, TRUE );
+        NTSTATUS status = send_debug_event( data, rec, context, TRUE );
         if (status == DBG_CONTINUE || status == DBG_EXCEPTION_HANDLED)
         {
             restore_context( data, context, sigcontext );
diff --git a/dlls/ntdll/unix/signal_i386.c b/dlls/ntdll/unix/signal_i386.c
--- a/dlls/ntdll/unix/signal_i386.c
+++ b/dlls/ntdll/unix/signal_i386.c
@@ -1495,7 +1495,7 @@
     size_t stack_size;
     NTSTATUS status;
 
-    status = send_debug_event( data, rec, context, TRUE, TRUE );
+    status = send_debug_event( data, rec, context, TRUE );
     if (status == DBG_CONTINUE || status == DBG_EXCEPTION_HANDLED)
     {
         restore_context( data, context, sigcontext );
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -1496,7 +1496,7 @@
     XSAVE_AREA_HEADER *src_xs;
     void *callback;
 
-    status = send_debug_event( data, rec, context, TRUE, TRUE );
+    status = send_debug_event( data, rec, context, TRUE );
     if (status == DBG_CONTINUE || status == DBG_EXCEPTION_HANDLED)
     {
         restore_context( data, xcontext, sigcontext );
diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -1626,7 +1626,7 @@
  * Send an EXCEPTION_DEBUG_EVENT event to the debugger.
  */
 NTSTATUS send_debug_event( struct thread_data *data, EXCEPTION_RECORD *rec,
-                           CONTEXT *context, BOOL first_chance, BOOL exception )
+                           CONTEXT *context, BOOL first_chance )
 {
     unsigned int ret;
     DWORD i;
@@ -1670,7 +1670,7 @@
 
         contexts_to_server( server_contexts, context );
         server_contexts[0].flags |= SERVER_CTX_EXEC_SPACE;
-        server_contexts[0].exec_space.space.space = exception ? EXEC_SPACE_EXCEPTION : EXEC_SPACE_SYSCALL;
+        server_contexts[0].exec_space.space.space = EXEC_SPACE_EXCEPTION;
         server_select( &select_op, offsetof( union select_op, wait.handles[1] ), SELECT_INTERRUPTIBLE,
                        TIMEOUT_INFINITE, server_contexts, NULL );
 
@@ -1694,7 +1694,7 @@
 NTSTATUS WINAPI NtRaiseException( EXCEPTION_RECORD *rec, CONTEXT *context, BOOL first_chance )
 {
     struct thread_data *data = get_thread_data();
-    NTSTATUS status = send_debug_event( data, rec, context, first_chance, !(is_win64 || is_wow64()) );
+    NTSTATUS status = send_debug_event( data, rec, context, first_chance );
 
     if (status == DBG_CONTINUE || status == DBG_EXCEPTION_HANDLED)
         return NtContinue( context, FALSE );
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -285,7 +285,7 @@
 extern void DECLSPEC_NORETURN exit_process( int status );
 extern void wait_suspend( CONTEXT *context );
 extern NTSTATUS send_debug_event( struct thread_data *data, EXCEPTION_RECORD *rec,
-                                  CONTEXT *context, BOOL first_chance, BOOL exception );
+                                  CONTEXT *context, BOOL first_chance );
 extern NTSTATUS set_thread_context( HANDLE handle, const void *context, BOOL *self, USHORT machine );
 extern NTSTATUS get_thread_context( HANDLE handle, void *context, BOOL *self, USHORT machine );
 extern unsigned int alloc_object_attributes( const OBJECT_ATTRIBUTES *attr, struct object_attributes **ret,
diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -883,6 +883,7 @@
     else
     {
         GLint front;
+        GLuint vao;
 
         pthread_once( &once, init_framebuffer_program );
         funcs->p_glUseProgram( framebuffer_program );
@@ -902,7 +903,12 @@
         pthread_mutex_unlock( &gamma_lock );
 
         funcs->p_glViewport( 0, 0, dst.cx, dst.cy );
+
+        /* macOS OpenGL requires a VAO for glDrawArrays */
+        funcs->p_glGenVertexArrays( 1, &vao );
+        funcs->p_glBindVertexArray( vao );
         funcs->p_glDrawArrays( GL_TRIANGLE_STRIP, 0, 4 );
+        funcs->p_glDeleteVertexArrays( 1, &vao );
     }
 
     if (drawable->srgb) funcs->p_glDisable( GL_FRAMEBUFFER_SRGB );
